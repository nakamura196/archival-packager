# ストアの申請 API に使う値。**実値は書かない。** 1Password から取る。
# 使い方: op run --env-file=store/.env -- python scripts/store_submit.py ...
#
# 1Password の項目は store/API設定手順.md のとおりに作る（項目名にパレンを使わない）。
STORE_TENANT_ID=op://Personal/microsoft-store-api/tenant_id
STORE_CLIENT_ID=op://Personal/microsoft-store-api/client_id
STORE_CLIENT_SECRET=op://Personal/microsoft-store-api/client_secret
STORE_ID=op://Personal/microsoft-store-api/store_id
