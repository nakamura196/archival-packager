<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX（Microsoft Store が扱う配布形式）のマニフェスト雛形。

  @EXE@ と @VERSION@ は CI が実際の値に置き換える。

  Identity の Name / Publisher は Partner Center が発行する値でなければならない。
  アカウントを作るまで確定しないので、いまは検証用の値を入れてある。
  **この値のままでは Store に受理されない。** アカウントを作ったら、
  Partner Center の「製品 ID」ページに出る値をここへ書き写す。

  runFullTrust は Win32 アプリを MSIX に包むときの標準的な指定。
  同梱した clamscan / sf を子プロセスとして起動するために要る。
  Store 提出時は制限付き機能として申告する（デスクトップアプリでは通例認められる）。
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="Nakamura.ArchivalPackager"
      Publisher="CN=Archival Packager Development"
      Version="@VERSION@"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Archival Packager</DisplayName>
    <PublisherDisplayName>Satoru Nakamura</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="ArchivalPackager" Executable="@EXE@" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Archival Packager"
          Description="デジタル資料から OAIS の情報パッケージ（SIP / AIP）を作成します。"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- ウイルス定義の取得（freshclam）に要る。 -->
    <Capability Name="internetClient" />
    <!-- 同梱バイナリを子プロセスとして起動するために要る。 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
